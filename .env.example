# =============================================================================
# LounaFlow v2 - Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Base de données PostgreSQL
# -----------------------------------------------------------------------------
# Railway: Cette variable est automatiquement injectée quand vous ajoutez PostgreSQL
# Local: postgresql://utilisateur:mot_de_passe@localhost:5432/nom_base
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lounaflow"

# -----------------------------------------------------------------------------
# JWT (Authentification)
# -----------------------------------------------------------------------------
# Générez une clé secrète unique avec:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="remplacez_par_une_cle_secrete_unique_aleatoire"
JWT_EXPIRES_IN="24h"

# -----------------------------------------------------------------------------
# Compte Admin par défaut (créé automatiquement si aucun utilisateur)
# -----------------------------------------------------------------------------
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="louna2026"

# -----------------------------------------------------------------------------
# Environnement
# -----------------------------------------------------------------------------
NODE_ENV="development"
PORT=3001

# -----------------------------------------------------------------------------
# Frontend - URL de l'API (seulement pour le développement local)
# -----------------------------------------------------------------------------
# En production, laissez vide -> chemins relatifs
# En développement: http://localhost:3001
VITE_API_URL="http://localhost:3001"

# -----------------------------------------------------------------------------
# Module QMS - Microsoft Graph (OneDrive/SharePoint, lecture seule)
# -----------------------------------------------------------------------------
# App-only (client credentials). Permission Graph requise : Sites.Read.All (consentement admin).
# Si ces variables sont absentes, la synchro QMS est simplement désactivée (l'app fonctionne).
GRAPH_TENANT_ID=""
GRAPH_CLIENT_ID=""
GRAPH_CLIENT_SECRET=""
# Bibliothèque SharePoint "Documents" du site LOUNA AESTHETICS
GRAPH_DRIVE_ID=""
# Item id du dossier racine à indexer (02_ASSURANCE QUALITÉ)
GRAPH_ROOT_ITEM_ID=""
# Nom du dossier racine (pour le calcul des chemins relatifs / processus)
GRAPH_QA_FOLDER_NAME="02_ASSURANCE QUALITÉ"
# Webhooks (optionnel) : URL publique de l'endpoint + secret partagé (clientState).
# Laisser vide pour s'appuyer uniquement sur delta + réconciliation.
GRAPH_NOTIFICATION_URL=""
GRAPH_WEBHOOK_SECRET=""
# Seuil d'alerte d'obsolescence de la synchro (minutes)
QMS_SYNC_STALE_MINUTES="60"
